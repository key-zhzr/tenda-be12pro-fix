From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: ChatGPT RFT <rft@example.invalid>
Date: Tue, 29 Sep 2026 20:40:00 +0800
Subject: [PATCH 1/2] mediatek: an8855: preserve PMCR state and fix flow-control bit definitions

This is an RFT patch for the AN8855 link-flapping problem observed on
Tenda BE12 Pro with Linux 6.18.

The downstream AN8855 driver assigns the return value of regmap_read()
back to the register variable in an8855_phylink_mac_link_up(). On a
successful read this normally replaces the actual PMCR register value
with zero before the driver modifies and writes it back.

MediaTek's newer AN8855 v2.0.1 patchset fixes the same assignment bug
and also swaps the RX/TX flow-control bit definitions. Carry those two
small fixes without importing the much larger vendor patchset.

Add lightweight PMCR/PMSR logging around link transitions so failed RFT
runs still provide useful evidence.

---
 .../mediatek/files-6.18/drivers/net/dsa/an8855.c | 35 ++++++++++++++++++++---
 .../mediatek/files-6.18/drivers/net/dsa/an8855.h |  4 +--
 2 files changed, 33 insertions(+), 6 deletions(-)

diff --git a/target/linux/mediatek/files-6.18/drivers/net/dsa/an8855.c b/target/linux/mediatek/files-6.18/drivers/net/dsa/an8855.c
index 0a39368d6dd2..111111111111 100644
--- a/target/linux/mediatek/files-6.18/drivers/net/dsa/an8855.c
+++ b/target/linux/mediatek/files-6.18/drivers/net/dsa/an8855.c
@@ -1535,6 +1535,20 @@ static void an8855_phylink_get_caps(struct dsa_switch *ds, int port,
 				   MAC_10 | MAC_100 | MAC_1000FD | MAC_2500FD;
 }
 
+static void an8855_rft_dump_port(struct an8855_priv *priv, int port,
+				 const char *event)
+{
+	u32 pmcr = 0, pmsr = 0;
+	int r_pmcr, r_pmsr;
+
+	r_pmcr = regmap_read(priv->regmap, AN8855_PMCR_P(port), &pmcr);
+	r_pmsr = regmap_read(priv->regmap, AN8855_PMSR_P(port), &pmsr);
+
+	dev_info(priv->dev,
+		 "AN8855-RFT: port=%d event=%s PMCR=%#010x(%d) PMSR=%#010x(%d)\n",
+		 port, event, pmcr, r_pmcr, pmsr, r_pmsr);
+}
+
 static void an8855_phylink_mac_link_down(struct phylink_config *config,
 					 unsigned int mode,
 					 phy_interface_t interface)
@@ -1553,6 +1567,8 @@ static void an8855_phylink_mac_link_down(struct phylink_config *config,
 				   AN8855_PMCR_FORCE_MODE | AN8855_PMCR_FORCE_LNK,
 				   AN8855_PMCR_FORCE_MODE);
 	}
+
+	an8855_rft_dump_port(priv, dp->index, "link-down");
 }
 
 static void an8855_phylink_mac_link_up(struct phylink_config *config,
@@ -1564,9 +1580,16 @@ static void an8855_phylink_mac_link_up(struct phylink_config *config,
 	struct dsa_port *dp = dsa_phylink_to_port(config);
 	struct an8855_priv *priv = dp->ds->priv;
 	int port = dp->index;
+	int ret;
 	u32 reg;
 
-	reg = regmap_read(priv->regmap, AN8855_PMCR_P(port), &reg);
+	ret = regmap_read(priv->regmap, AN8855_PMCR_P(port), &reg);
+	if (ret) {
+		dev_err(priv->dev, "AN8855-RFT: failed to read PMCR for port %d: %d\n",
+			port, ret);
+		return;
+	}
+
 	if (phylink_autoneg_inband(mode)) {
 		reg &= ~AN8855_PMCR_FORCE_MODE;
 	} else {
@@ -1611,7 +1634,12 @@ static void an8855_phylink_mac_link_up(struct phylink_config *config,
 
 	reg |= AN8855_PMCR_TX_EN | AN8855_PMCR_RX_EN;
 
-	regmap_write(priv->regmap, AN8855_PMCR_P(port), reg);
+	ret = regmap_write(priv->regmap, AN8855_PMCR_P(port), reg);
+	if (ret)
+		dev_err(priv->dev, "AN8855-RFT: failed to write PMCR for port %d: %d\n",
+			port, ret);
+	else
+		an8855_rft_dump_port(priv, port, "link-up");
 }
 
 static unsigned int an8855_pcs_inband_caps(struct phylink_pcs *pcs,
diff --git a/target/linux/mediatek/files-6.18/drivers/net/dsa/an8855.h b/target/linux/mediatek/files-6.18/drivers/net/dsa/an8855.h
index 2462b9d00000..222222222222 100644
--- a/target/linux/mediatek/files-6.18/drivers/net/dsa/an8855.h
+++ b/target/linux/mediatek/files-6.18/drivers/net/dsa/an8855.h
@@ -419,8 +419,8 @@ enum an8855_vlan_port_acc_frm {
 #define   AN8855_PMCR_FORCE_EEE2P5G	BIT(8)
 #define   AN8855_PMCR_FORCE_EEE1G	BIT(7)
 #define   AN8855_PMCR_FORCE_EEE100	BIT(6)
-#define   AN8855_PMCR_TX_FC_EN		BIT(5)
-#define   AN8855_PMCR_RX_FC_EN		BIT(4)
+#define   AN8855_PMCR_RX_FC_EN		BIT(5)
+#define   AN8855_PMCR_TX_FC_EN		BIT(4)
 
 #define AN8855_PMSR_P(x)		(0x10210010 + (x) * 0x200)
 #define   AN8855_PMSR_SPEED		GENMASK(30, 28)
-- 
